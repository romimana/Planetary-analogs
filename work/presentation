  .card.highlight-mars { border-color: rgba(249, 115, 22, 0.45); }
  .card.highlight-emerald { border-color: rgba(52, 211, 153, 0.45); }
  .card.highlight-amber { border-color: rgba(251, 191, 36, 0.45); }

  .card-badge {
    display: inline-block;
    width: fit-content;
