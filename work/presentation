    <button class="nav-arrow" onclick="changeSlide(-1)">&#8592; Prev</button>
    <span class="slide-counter" id="slideCounter">1 / 9</span>
    <button class="nav-arrow" onclick="changeSlide(1)">Next &#8594;</button>
  </footer>

<script>
  const slides = Array.from(document.querySelectorAll('.slide'));
  const pillsContainer = document.getElementById('slidePills');
  const counterEl = document.getElementById('slideCounter');
  let currentIdx = 0;
  let editMode = false;

  pillsContainer.replaceChildren();
  slides.forEach((slide, idx) => slide.classList.toggle('active', idx === 0));

  // Build top navigation pills
  slides.forEach((slide, idx) => {
    const btn = document.createElement('button');
    btn.className = 'pill-btn' + (idx === 0 ? ' active' : '');
    btn.textContent = slide.dataset.title || `Slide ${idx + 1}`;
    btn.onclick = () => goToSlide(idx);
    pillsContainer.appendChild(btn);
  });

  function goToSlide(idx, { launch = true, remember = true } = {}) {
    if (idx < 0 || idx >= slides.length) return;
    slides[currentIdx].classList.remove('active');
    pillsContainer.children[currentIdx].classList.remove('active');
    currentIdx = idx;
    slides[currentIdx].classList.add('active');
    pillsContainer.children[currentIdx].classList.add('active');
    counterEl.textContent = `${currentIdx + 1} / ${slides.length}`;
    if (remember) history.replaceState({ slide: idx }, '');
    const demoLink = slides[idx].id === 'live-demo' && slides[idx].querySelector('a.primary');
    if (launch && demoLink) location.assign(demoLink.href);
  }

  goToSlide(history.state?.slide ?? 0, { launch: false, remember: false });

  function changeSlide(delta) {
    goToSlide((currentIdx + delta + slides.length) % slides.length);
  }

  document.addEventListener('keydown', (e) => {
    if (editMode && document.activeElement && document.activeElement.isContentEditable) return;
    if (e.key === 'ArrowRight' || e.key === 'PageDown') changeSlide(1);
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') changeSlide(-1);
  });

  // Live On-Screen Text Editor
  function toggleEditMode() {
    editMode = !editMode;
    const btn = document.getElementById('editToggleBtn');
    const editables = document.querySelectorAll('.editable');
    editables.forEach(el => {
      el.contentEditable = editMode ? 'true' : 'false';
    });
    if (editMode) {
      btn.classList.add('edit-active');
      btn.textContent = 'Editing Active (Click Text)';
    } else {
      btn.classList.remove('edit-active');
      btn.textContent = 'Edit Slide Text';
    }
  }

  // Save Edited HTML File
  function downloadEditedHTML() {
    const wasEditing = editMode;
    if (wasEditing) toggleEditMode();
    const docHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    const blob = new Blob([docHtml], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'planetary_analogs_pitch_edited.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    if (wasEditing) toggleEditMode();
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

</script>
