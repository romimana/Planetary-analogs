  .kicker.emerald { color: var(--accent-emerald); }
  .kicker.amber { color: var(--accent-amber); }

  h1 {
    font-size: 2.65rem;
    line-height: 1.14;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
