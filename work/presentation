    --text-muted: #94a3b8;
    --accent-cyan: #38bdf8;
    --accent-mars: #f97316;
    --accent-amber: #fbbf24;
    --accent-emerald: #34d399;
    --accent-purple: #a78bfa;
    --accent-red: #f87171;
  }

